{
  "name": "resolvex-autonomous-agent",
  "version": "1.0.0",
  "description": "ResolveX — Autonomous Customer Resolution Agent",
  "main": "dist-backend/backend/server.js",
  "scripts": {
    "dev:backend": "npx tsx watch src/backend/server.ts",
    "dev:frontend": "vite",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npx --no-install tsc -p tsconfig.json",
    "build:frontend": "npx --no-install vite build",
    "build": "npm run build:backend && npm run build:frontend",
    "start": "node dist-backend/backend/server.js",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed:prod": "npx tsx prisma/seed.prod.ts",
    "db:generate:pg": "npx prisma generate --schema=prisma/schema.pg.prisma",
    "db:push:pg": "npx prisma db push --schema=prisma/schema.pg.prisma",
    "db:migrate:prod": "npx prisma migrate deploy --schema=prisma/schema.pg.prisma",
    "test:pg": "vitest run tests/postgresql_integration.test.ts --fileParallelism=false",
    "evaluate": "npx tsx src/evaluation/cli.ts",
    "test": "vitest run --fileParallelism=false"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "keywords": [
    "resolvex",
    "ai-agent",
    "customer-resolution",
    "autonomous-agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "lucide-react": "^0.395.0",
    "prisma": "6.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}
