# ----------------------------------------------------
# ResolveX Autonomous Agent — Environment Configuration
# ----------------------------------------------------

# Environment (development | test | staging | production)
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Security & Authentication (MUST be 32+ char secret in production)
RESOLVEX_AUTH_SECRET="resolvex-production-security-secret-key-32bytes-min"

# Execution Worker & Concurrency Controls
RESOLVEX_WORKER_CONCURRENCY=5
SHUTDOWN_GRACE_MS=30000

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL="file:./dev.db"

# AI Provider API Keys (Optional if mock engine used)
OPENAI_API_KEY="sk-placeholder"
GEMINI_API_KEY="placeholder"

# ResolveX Policy Guardrails & Thresholds
AUTO_REFUND_LIMIT_INR=10000
MAX_REPLAN_ATTEMPTS=3
ENABLE_VERIFICATION_CHECK=true

# Deployment & Build Metadata
RESOLVEX_VERSION="22.0.0"
RESOLVEX_COMMIT_SHA="development-local-build"


